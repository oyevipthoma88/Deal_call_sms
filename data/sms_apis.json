[
  {
    "name": "Fast2SMS Quick",
    "url": "https://www.fast2sms.com/dev/bulkV2",
    "method": "POST",
    "headers": {
      "authorization": "YOUR_FAST2SMS_KEY",
      "Content-Type": "application/json"
    },
    "body": {"route": "q", "message": "Test", "numbers": "{phone}", "flash": 0},
    "type": "indian_sms"
  },
  {
    "name": "SMSLocal",
    "url": "https://app.smslocal.in/api/smsapi",
    "method": "POST",
    "headers": {"Content-Type": "application/json"},
    "body": {"apiKey": "YOUR_SMSLOCAL_KEY", "senderId": "SMSLCL", "to": "{phone}", "message": "Test"},
    "type": "indian_sms"
  },
  {
    "name": "Lenskart SMS (needs session)",
    "url": "https://api-gateway.juno.lenskart.com/v3/customers/sendOtp",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "User-Agent": "Mozilla/5.0 (Linux; Android 10; SM-G973F) AppleWebKit/537.36",
      "Origin": "https://www.lenskart.com"
    },
    "body": {"phoneCode": "+91", "telephone": "{phone}"},
    "type": "free_public"
  }
]
